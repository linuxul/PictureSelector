<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_color_white">

    <View
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/app_color_grey"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/left_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        android:src="@drawable/ps_ic_white_back"
        app:layout_constraintBottom_toBottomOf="@id/view_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@id/view_title" />

    <com.luck.picture.lib.widget.MediumBoldTextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:ellipsize="end"
        android:gravity="center"
        android:maxEms="11"
        android:text="@string/app_name"
        android:textColor="@color/app_color_white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/view_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/view_title" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_title">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/recycler"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/layout_number" />
                <include layout="@layout/layout_video_number" />
                <include layout="@layout/layout_row_number" />
                <include layout="@layout/layout_page_number" />

                <CheckBox
                    android:id="@+id/check_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시스템 앨범"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <RadioGroup
                    android:id="@+id/rgb_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="전체"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="사진"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="동영상"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오디오"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />
                </RadioGroup>

                <RadioGroup
                    android:id="@+id/rgb_style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_default"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="기본 스타일"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="흰색 스타일"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_num_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="숫자 스타일"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />
                </RadioGroup>

                <RadioGroup
                    android:id="@+id/rgb_window"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_window_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:button="@drawable/ps_ic_trans_1px"
                        android:enabled="false"
                        android:text="시작 효과"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_default_window_anim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="기본"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_window_up_anim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="아래에서 위로"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />
                </RadioGroup>

                <RadioGroup
                    android:id="@+id/rgb_list_anim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_list_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:button="@drawable/ps_ic_trans_1px"
                        android:enabled="false"
                        android:text="목록 애니메이션"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_default_list_anim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="기본"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_alpha_list_anim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="투명도 효과"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_scale_list_anim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="아래에서 확대"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />
                </RadioGroup>

                <RadioGroup
                    android:id="@+id/rgb_selected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_single"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="단일 선택"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_only_single"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="단일 선택 후 닫기"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_multiple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="다중 선택"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />
                </RadioGroup>

                <RadioGroup
                    android:id="@+id/rgb_result_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_callback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="callback"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_request_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="requestCode"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_launcher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="launcher"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />
                </RadioGroup>

                <RadioGroup
                    android:id="@+id/rgb_player"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_player_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:button="@drawable/ps_ic_trans_1px"
                        android:checked="true"
                        android:enabled="false"
                        android:text="동영상 플레이어"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_default_player"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="기본"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_exo_player"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ExoPlayer"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_ijk_player"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IjkPlayer"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_system_player"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="시스템"
                        android:textColor="@color/ps_color_black"
                        android:textSize="14sp" />
                </RadioGroup>

                <com.luck.pictureselector.LineWrapRadioGroup
                    android:id="@+id/rgb_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_system_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="시스템 언어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_chinese_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="중국어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_tw_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="중국어(번체)"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_us_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="영어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_ko_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="한국어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_spanish_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="스페인어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_de_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="독일어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_fr_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="프랑스어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_ja_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="일본어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_pt_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="포르투갈어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_ar_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="아랍어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_ru_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="러시아어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_cs_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="체코어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_kk_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="카자흐어"
                        android:textColor="@color/app_color_53575e"
                        android:textSize="14sp" />

                </com.luck.pictureselector.LineWrapRadioGroup>

                <CheckBox
                    android:id="@+id/check_display_camera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사진 촬영 표시"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_camera_services"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사진 촬영 시 백그라운드 서비스 사용"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_only_camera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사진 촬영만"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_custom_camera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사용자 정의 카메라"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_output"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사용자 정의 폴더에 저장"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_only_dir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="지정된 폴더만 검색"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_time_axis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="타임라인 표시"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_fast_select"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="길게 눌러 선택"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_empty_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="결과 없을 때 닫기 허용"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_crop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="자르기"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_editor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="편집"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_enabled_mask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="선택 불가 항목에 마스크 표시"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_lifecycle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="화면 생명주기 리스너"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_apply_permission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사용자 정의 권한 요청"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_original"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="원본 사진"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_gif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GIF 표시"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_webp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WebP 표시"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_bmp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BMP 표시"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_heic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEIC 표시"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="사용자 정의 선택 제한"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_auto_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오디오/비디오 자동 재생"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_loop_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오디오/비디오 반복 재생"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_pause_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="동영상 일시정지/이어보기"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_long_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="긴 이미지 미리보기 사용자 정의"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_effect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="미리보기 확대/축소 효과"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_full"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="미리보기 클릭 시 전체화면"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_preview_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="외부 미리보기에서 삭제 가능"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_preview_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="외부 미리보기에서 다운로드 가능"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_preview_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="사진 미리보기"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_preview_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="동영상 미리보기"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/check_preview_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="오디오 미리보기"
                    android:textColor="@color/ps_color_black"
                    android:textSize="14sp" />

            </LinearLayout>
        </ScrollView>

        <com.luck.picture.lib.widget.MediumBoldTextView
            android:id="@+id/tv_delete_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:alpha="0"
            android:background="@color/app_color_cc_red"
            android:drawableTop="@drawable/ic_normal_delete"
            android:drawablePadding="5dp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/app_drag_delete"
            android:textColor="@color/app_color_white"
            android:textSize="12sp"
            tools:alpha="1" />

        <View
            android:id="@+id/view_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@+id/recycler"
            android:layout_alignBottom="@+id/recycler"
            android:background="@color/app_color_white" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:overScrollMode="never" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
